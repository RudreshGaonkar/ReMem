{
  "name": "cuttlehawk-context-engine",
  "displayName": "Cuttlehawk — Local AI Context & AST Engine",
  "description": "Local RAG middleman, state manager, and token optimization engine for AI coding agents.",
  "version": "0.2.0",
  "icon": "icon.png",
  "publisher": "RudreshGaonkar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RudreshGaonkar/Cuttlehawk.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:cuttlehawk",
    "onCommand:cuttlehawk.status",
    "onCommand:cuttlehawk.showScratchpad",
    "onCommand:cuttlehawk.searchSummaries",
    "onCommand:cuttlehawk.reindexWorkspace",
    "onCommand:cuttlehawk.showDirectoryTree",
    "onCommand:cuttlehawk.addPostMortem",
    "onCommand:cuttlehawk.showErrorContext",
    "onCommand:cuttlehawk.lockVault",
    "onCommand:cuttlehawk.encryptActiveFile",
    "onCommand:cuttlehawk.viewVaultSecrets",
    "onCommand:cuttlehawk.getContext",
    "onCommand:cuttlehawk.purgeMemory",
    "onCommand:cuttlehawk.toggleSync",
    "onCommand:cuttlehawk.reviewDiff",
    "onCommand:cuttlehawk.syncTaskProgress",
    "onCommand:cuttlehawk.logDebt",
    "onCommand:cuttlehawk.toggleZeroFluffMode",
    "onCommand:cuttlehawk.installSkill"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cuttlehawk.status",
        "title": "Cuttlehawk: Check Context Engine Status"
      },
      {
        "command": "cuttlehawk.showScratchpad",
        "title": "Cuttlehawk: Open Active Scratchpad"
      },
      {
        "command": "cuttlehawk.searchSummaries",
        "title": "Cuttlehawk: Search Context Summaries"
      },
      {
        "command": "cuttlehawk.reindexWorkspace",
        "title": "Cuttlehawk: Re-index Workspace Files"
      },
      {
        "command": "cuttlehawk.showDirectoryTree",
        "title": "Cuttlehawk: Show Workspace Structure Tree"
      },
      {
        "command": "cuttlehawk.addPostMortem",
        "title": "Cuttlehawk: Log Post-Mortem / Error Note"
      },
      {
        "command": "cuttlehawk.showErrorContext",
        "title": "Cuttlehawk: Show Active Error Ledger Context"
      },
      {
        "command": "cuttlehawk.lockVault",
        "title": "Cuttlehawk: Lock Secure Secrets Vault"
      },
      {
        "command": "cuttlehawk.encryptActiveFile",
        "title": "Cuttlehawk: Encrypt Active File to Vault"
      },
      {
        "command": "cuttlehawk.viewVaultSecrets",
        "title": "Cuttlehawk: View/Decrypt Vault Secrets"
      },
      {
        "command": "cuttlehawk.getContext",
        "title": "Cuttlehawk: Generate Token-Optimized AI Context"
      },
      {
        "command": "cuttlehawk.purgeMemory",
        "title": "Cuttlehawk: Purge and Rebuild Local Memory"
      },
      {
        "command": "cuttlehawk.toggleSync",
        "title": "Cuttlehawk: Toggle Engine / Manual Sync"
      },
      {
        "command": "cuttlehawk.reviewDiff",
        "title": "Cuttlehawk: Audit Active / Staged Diff"
      },
      {
        "command": "cuttlehawk.syncTaskProgress",
        "title": "Cuttlehawk: Sync Spec & Task Progress"
      },
      {
        "command": "cuttlehawk.logDebt",
        "title": "Cuttlehawk: Collect Tech Debt Ledger"
      },
      {
        "command": "cuttlehawk.toggleZeroFluffMode",
        "title": "Cuttlehawk: Toggle Zero-Fluff Mode"
      },
      {
        "command": "cuttlehawk.installSkill",
        "title": "Cuttlehawk: Install CLI Skill & MCP Config"
      }
    ],
    "chatParticipants": [
      {
        "id": "cuttlehawk",
        "name": "cuttlehawk",
        "fullName": "Cuttlehawk Context Engine",
        "description": "AI memory, token optimization, and persistent knowledge graph",
        "isSticky": true
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Cuttlehawk Context Engine",
      "properties": {
        "cuttlehawk.enableAutoSummarize": {
          "type": "boolean",
          "default": true,
          "description": "Automatically summarize files on save."
        },
        "cuttlehawk.vaultSessionTimeoutMinutes": {
          "type": "number",
          "default": 60,
          "description": "Duration in minutes to cache vault master password in memory."
        },
        "cuttlehawk.lruContextTurnLimit": {
          "type": "number",
          "default": 3,
          "description": "Number of conversation turns before untouched files are pruned from active context."
        },
        "cuttlehawk.ZeroFluffMode": {
          "type": "boolean",
          "default": false,
          "description": "When Zero-Fluff Mode is enabled, the agent silently runs the four-point security and compliance audit before writing or modifying code, emits no <thinking> tags, and outputs only hardened code or diffs."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "build": "node esbuild.js --production",
    "package": "vsce package --no-dependencies",
    "install:ide": "npm run package && node scripts/install-ide.cjs",
    "build:mcp": "node esbuild.js --production --mcp",
    "prepack": "npm run build",
    "test": "npm run build:mcp && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@orama/orama": "^2.0.23",
    "chokidar": "^4.0.3",
    "ignore": "^7.0.14",
    "jsonc-parser": "^3.3.1",
    "simple-git": "^4.1.0",
    "smol-toml": "^1.9.1",
    "sql.js": "^1.12.0",
    "web-tree-sitter": "^0.24.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3"
  },
  "bin": {
    "cuttlehawk-mcp": "out/cuttlehawk-mcp.js"
  },
  "files": [
    "out/extension.js",
    "out/cuttlehawk-mcp.js",
    "out/storage-worker.js",
    "out/*.wasm",
    "skills/cuttlehawk/SKILL.md",
    "icon.png",
    "LICENSE"
  ]
}