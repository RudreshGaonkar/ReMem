.vscode/**
.vscode-test/**
src/**
tsconfig.json
esbuild.js
.gitignore
.antigravityMem/**
.recall_scratchpad.md
*.md
!README.md
node_modules/**
# Exclude all sourcemaps
out/**/*.map
